{
  "name": "enfesto-cad",
  "version": "0.1.0",
  "private": true,
  "description": "CAD industrial de enfesto, encaixe (nesting) e preparação para corte têxtil",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "validar": "npm run build && electron scripts/validacao/main.cjs",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "package:win": "electron-builder --win --x64",
    "package:mac": "electron-builder --mac --universal"
  },
  "dependencies": {
    "blob-stream": "^0.1.3",
    "exceljs": "^4.4.0",
    "fontkit": "2.0.4",
    "pdfkit": "^0.20.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/blob-stream": "^0.1.33",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "dxf-parser": "1.1.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "gcode-parser": "2.2.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^6.4.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "electron@44.4.5": true,
    "esbuild@0.25.12": true
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "build": {
    "appId": "com.enfestocad.app",
    "productName": "Enfesto CAD",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Enfesto-CAD-${version}-mac.${ext}"
    },
    "dmg": {
      "icon": "build/icon.icns",
      "title": "Enfesto CAD"
    }
  }
}
